{
  "name": "ratiomap",
  "version": "2.0.0",
  "description": "Recherche de lieux avec classement pondéré des avis Google",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "build": "npm run typecheck && vite build && esbuild src/server/start.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist/server.cjs",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write src tests docs public index.html server.js *.json *.mts .github",
    "format:check": "prettier --check src tests docs public index.html server.js *.json *.mts .github"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.0",
    "@netlify/blobs": "^10.7.11",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^4.17.25",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
