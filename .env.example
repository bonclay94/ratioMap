# Clé serveur : Geocoding, Places (recherche, détails)... jamais envoyée au
# navigateur. Restreindre cette clé aux API serveur nécessaires dans Google Cloud.
GOOGLE_MAPS_API_KEY=colle_ta_cle_serveur_ici

# Clé navigateur : uniquement Maps JavaScript API (carte + autocomplete).
# Visible en clair côté client : à restreindre par référent HTTP (ton domaine)
# dans Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=colle_ta_cle_navigateur_ici

PORT=3000

# Facultatif : active les marqueurs avancés. Sans Map ID, marqueurs classiques.
GOOGLE_MAPS_MAP_ID=

# Facultatif : aucun chargement publicitaire tant que ces valeurs sont vides.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=

# Facultatif : assistant « Décrire ma recherche » (API Claude). Clé serveur uniquement,
# jamais envoyée au navigateur. Sans clé, l'assistant est masqué et la recherche classique
# fonctionne normalement. Fixer un plafond de dépense dans la console Anthropic.
ANTHROPIC_API_KEY=
# Modèle utilisé par l'assistant ; claude-haiku-5-5 par défaut. Famille Claude 5 attendue.
ANTHROPIC_MODEL=claude-haiku-5-5
