# Clé serveur : Geocoding, Places (recherche, détails)... jamais envoyée au
# navigateur. Peut rester sans restriction de referrer/IP dans Google Cloud.
GOOGLE_MAPS_API_KEY=colle_ta_cle_serveur_ici

# Clé navigateur : uniquement Maps JavaScript API (carte + autocomplete).
# Visible en clair côté client : à restreindre par référent HTTP (ton domaine)
# dans Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=colle_ta_cle_navigateur_ici

PORT=3000
